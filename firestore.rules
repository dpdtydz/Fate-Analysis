rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is a verified administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == "lhs41977@gmail.com";
    }

    match /rooms/{code} {
      // Anyone can read a room with its code
      allow read: if true;
      // Listing rooms is allowed only for administrators
      allow list: if isAdmin();
      // Creating a room requires an authenticated session
      allow create: if request.auth != null;
      // Updating or deleting a room requires the owner or admin
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.owner_uid || isAdmin());
      
      match /members/{member_id} {
        // Anyone in the room can list/view members
        allow read: if true;
        // Joining or creating a member profile requires authentication
        allow create: if request.auth != null;
        // Editing or deleting member profiles requires owner or the user themselves or admin
        allow update, delete: if request.auth != null && (
          !('user_uid' in resource.data) ||
          resource.data.user_uid == null ||
          resource.data.user_uid == "" ||
          request.auth.uid == resource.data.user_uid || 
          request.auth.uid == get(/databases/$(database)/documents/rooms/$(code)).data.owner_uid ||
          isAdmin()
        );
      }
      
      match /analysis/{doc_id} {
        // Anyone can view or write computed analyses for this room
        allow read, write: if true;
      }
    }
    
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && (request.auth.uid == userId || isAdmin())) || userId.startsWith("guest_");

      match /joined_rooms/{code} {
        allow read, write: if (request.auth != null && (request.auth.uid == userId || isAdmin())) || userId.startsWith("guest_");
      }
    }

    // Survey Config
    match /survey_config/{configId} {
      // Anyone can read config to show the popup
      allow read: if true;
      // Only admin can write (create/update/delete)
      allow write: if isAdmin();
    }

    // Survey Responses
    match /survey_responses/{responseId} {
      // Anyone can create (submit) a response
      allow create: if true;
      // Only admin can read (get/list), update, delete
      allow read, update, delete: if isAdmin();
    }

    // App Config (Shop Toggle & Global Settings)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics Events (User Traffic & Interaction Logs)
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // User Single-Use Tickets & Referral Rewards
    match /user_tickets/{userId} {
      allow read: if true;
      allow write: if isAdmin() || 
                   (request.auth != null && request.auth.uid == userId) || 
                   userId.startsWith("guest_") ||
                   (resource == null) ||
                   (
                     request.resource.data.tickets.pdf >= resource.data.tickets.pdf &&
                     request.resource.data.tickets.secret >= resource.data.tickets.secret &&
                     request.resource.data.tickets.group >= resource.data.tickets.group &&
                     request.resource.data.tickets.all >= resource.data.tickets.all
                   );
    }

    // Product Matching Coupons
    match /coupons/{code} {
      // Anyone can read/validate a coupon if they know its code
      allow get: if true;
      // Only admin can list, create or delete coupons
      allow list, create, delete: if isAdmin();
      // Users can redeem coupon (atomic update of usedCount & usedUsers) under strict quota constraints
      allow update: if isAdmin() || (
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        request.resource.data.usedCount < resource.data.maxUses &&
        request.resource.data.productType == resource.data.productType &&
        request.resource.data.maxUses == resource.data.maxUses &&
        request.resource.data.isActive == resource.data.isActive &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (!('campaignSource' in resource.data) || request.resource.data.campaignSource == resource.data.campaignSource) &&
        (!('description' in resource.data) || request.resource.data.description == resource.data.description)
      );
    }
  }
}
