# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_LEMON_SQUEEZY_CHECKOUT_URL: Lemon Squeezy subscription/checkout hosted link.
# Used on the client side to redirect users to your payment page.
VITE_LEMON_SQUEEZY_CHECKOUT_URL="https://app.lemonsqueezy.com/checkout/buy/your-checkout-id-here"

# Google AdSense Settings (Optional)
# To enable live Ads, replace with your active AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# and your ad unit Slot ID. If empty, beautiful in-house premium promotions are rendered instead.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

