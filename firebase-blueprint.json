{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "An 인연사주 Saju matching room",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "owner_uid": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["title", "owner_uid", "created_at"]
    },
    "Member": {
      "title": "Member",
      "description": "A member of a room",
      "type": "object",
      "properties": {
        "nickname": { "type": "string" },
        "gender": { "type": "string", "enum": ["남성", "여성"] },
        "birth_date": { "type": "string" },
        "birth_time": { "type": "string" },
        "user_uid": { "type": "string" },
        "joined_at": { "type": "string" }
      },
      "required": ["nickname", "gender", "birth_date", "user_uid"]
    },
    "SurveyConfig": {
      "title": "SurveyConfig",
      "description": "Configuration for the usability evaluation popup",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "questions": { "type": "array" }
      },
      "required": ["active", "questions"]
    },
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "A submitted usability evaluation response",
      "type": "object",
      "properties": {
        "answers": { "type": "object" },
        "submittedAt": { "type": "string" },
        "userEmail": { "type": "string" },
        "userUid": { "type": "string" },
        "nickname": { "type": "string" }
      },
      "required": ["answers", "submittedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "A product matching coupon issued by master",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "productType": { "type": "string", "enum": ["pdf", "secret", "group", "all"] },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["code", "productType", "maxUses", "usedCount", "createdAt", "createdBy"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration for shop toggle, beta mode, and announcements",
      "type": "object",
      "properties": {
        "shop_enabled": { "type": "boolean" },
        "beta_free_mode": { "type": "boolean" },
        "announcement": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["shop_enabled", "beta_free_mode", "updatedAt"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "User interaction and traffic analytics event log",
      "type": "object",
      "properties": {
        "eventName": { "type": "string" },
        "category": { "type": "string" },
        "userTier": { "type": "string", "enum": ["free", "coupon", "paid"] },
        "metadata": { "type": "object" },
        "userUid": { "type": "string" },
        "roomCode": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["eventName", "timestamp"]
    },
    "UserTicketAccount": {
      "title": "UserTicketAccount",
      "description": "Single-use tickets and invitation rewards per user",
      "type": "object",
      "properties": {
        "userUid": { "type": "string" },
        "referralCode": { "type": "string" },
        "invitedCount": { "type": "integer" },
        "tickets": { "type": "object" },
        "consumedHistory": { "type": "array" },
        "userTier": { "type": "string", "enum": ["free", "coupon", "paid"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["userUid", "referralCode", "tickets"]
    }
  },
  "firestore": {
    "/user_tickets/{userId}": {
      "schema": "UserTicketAccount",
      "description": "User's remaining single-use tickets and consumption records"
    },
    "/app_config/{configId}": {
      "schema": "AppConfig",
      "description": "Global app config controlling paid shop on/off and beta mode"
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Event logs for user traffic, retention, and conversion metrics"
    },
    "/coupons/{code}": {
      "schema": "Coupon",
      "description": "Coupons matching products"
    },
    "/rooms/{code}": {
      "schema": "Room",
      "description": "Match room"
    },
    "/rooms/{code}/members/{memberId}": {
      "schema": "Member",
      "description": "Room members list"
    },
    "/survey_config/{configId}": {
      "schema": "SurveyConfig",
      "description": "Usability survey config"
    },
    "/survey_responses/{responseId}": {
      "schema": "SurveyResponse",
      "description": "Submitted usability survey response"
    }
  }
}
